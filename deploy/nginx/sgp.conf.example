# Copiar para /etc/nginx/conf.d/sgp.conf (ou incluir a partir do nginx principal)
# e ajustar server_name / TLS conforme o ambiente.
#
# Padrão de produção:
# - Frontend: /opt/sgp/current/frontend-dist
# - API SGP (Node): 127.0.0.1:3334 — proxy apenas do prefixo /api/

server {
    listen 80;
    server_name _;

    root /opt/sgp/current/frontend-dist;
    index index.html;

    # API SGP (backend interno na porta oficial 3334)
    location ^~ /api/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_pass http://127.0.0.1:3334/api/;
    }

    client_max_body_size 20m;

    location / {
        try_files $uri $uri/ /index.html;
    }
}

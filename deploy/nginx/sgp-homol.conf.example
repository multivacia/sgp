# Copiar para /etc/nginx/conf.d/sgp-homol.conf (ou incluir a partir do nginx principal)
# e ajustar apenas o bloco TLS/certbot no servidor.
#
# Padrao de homologacao:
# - Frontend: /var/www/sgp-homol
# - API SGP (Node): 127.0.0.1:4001 - proxy apenas do prefixo /api/
# - Dominio: sgp-homol.multivacia.com

server {
    listen 80;
    server_name sgp-homol.multivacia.com;

    root /var/www/sgp-homol;
    index index.html;

    # API SGP HML (backend interno na porta oficial 4001)
    location ^~ /api/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_pass http://127.0.0.1:4001/api/;
    }

    client_max_body_size 20m;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # TLS/certbot:
    # - manter este bloco HTTP para o desafio inicial
    # - depois emitir o certificado com certbot para sgp-homol.multivacia.com
    # - em seguida adicionar o server HTTPS correspondente sem alterar o proxy /api/
}

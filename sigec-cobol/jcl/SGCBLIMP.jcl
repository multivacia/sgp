//SGCBLIMP JOB (SIGEC,LIMP),'LIMPEZA AMBIENTE',
//         CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//         NOTIFY=&SYSUID,REGION=0M,TIME=30
//*
//*----------------------------------------------------------------*
//* SISTEMA .: SIGEC                                              *
//* JCL .....: SGCBLIMP - LIMPEZA DE AMBIENTE (DEV/HML)            *
//* FUNCAO ..: APAGA GDG/ARQ SEQUENCIAIS, ZERA TABELAS TRANSACIO-  *
//*            NAIS DO DB2 (DELETE + RESET IDENTITY).              *
//* USO .....: EXCLUSIVAMENTE EM AMBIENTES NAO-PRODUTIVOS.         *
//* ATENCAO .: NAO EXECUTAR EM PRD - VER GATE DE APROVACAO.        *
//*----------------------------------------------------------------*
//*
//JOBLIB   DD  DSN=DB2P.DB2.SDSNLOAD,DISP=SHR
//*
//*-------- STEP010 - DELETE GDG (SCRATCH + PURGE) ----------------
//STEP010  EXEC PGM=IDCAMS
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
  DELETE SIGEC.LAB.IN.SGLCTRIN  GDG FORCE PURGE
  DELETE SIGEC.LAB.IN.SGLPAGIN  GDG FORCE PURGE
  DELETE SIGEC.LAB.OUT.SGLCTRVL GDG FORCE PURGE
  DELETE SIGEC.LAB.OUT.SGLCTRRE GDG FORCE PURGE
  DELETE SIGEC.LAB.OUT.SGLPAGVL GDG FORCE PURGE
  DELETE SIGEC.LAB.OUT.SGLPAGRE GDG FORCE PURGE
  DELETE SIGEC.LAB.OUT.SGLENCAR GDG FORCE PURGE
  DELETE SIGEC.LAB.OUT.SGLINADI GDG FORCE PURGE
  DELETE SIGEC.LAB.OUT.SGLPROP  GDG FORCE PURGE
  DELETE SIGEC.LAB.OUT.SGLINTCB GDG FORCE PURGE
  DELETE SIGEC.LAB.OUT.SGLINTCT GDG FORCE PURGE
  DELETE SIGEC.LAB.OUT.SGLINTRG GDG FORCE PURGE
  DELETE SIGEC.LAB.OUT.SGLRELDT GDG FORCE PURGE
  DELETE SIGEC.LAB.OUT.SGLRELST GDG FORCE PURGE
  DELETE SIGEC.LAB.LOG.SGLLOG   GDG FORCE PURGE
  SET MAXCC = 0
/*
//*
//*-------- STEP020 - DELETE ARQUIVOS SEQUENCIAIS DE APOIO --------
//STEP020  EXEC PGM=IDCAMS
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
  DELETE SIGEC.LAB.OPS.SGLESTAT
  DELETE SIGEC.LAB.OPS.SGLERROS
  DELETE SIGEC.LAB.OPS.SGLERROS.OUT
  SET MAXCC = 0
/*
//*
//*-------- STEP030 - LIMPEZA VSAM SGVCOBRA -----------------------
//STEP030  EXEC PGM=IDCAMS
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
  DELETE (SIGEC.LAB.VSAM.SGVCOBRA) CLUSTER
  SET MAXCC = 0
/*
//*
//*-------- STEP040 - LIMPEZA DE DADOS EM DB2 ---------------------
//STEP040  EXEC PGM=IKJEFT01,DYNAMNBR=20,COND=(4,LT)
//STEPLIB  DD  DSN=DB2P.DB2.SDSNLOAD,DISP=SHR
//SYSTSPRT DD  SYSOUT=*
//SYSPRINT DD  SYSOUT=*
//SYSTSIN  DD  *
  DSN SYSTEM(DB2P)
  RUN  PROGRAM(DSNTEP2) PLAN(SIGECPLN)
  END
//SYSIN    DD  DSN=SIGEC.LAB.SQL.LIMPEZA(DELDADOS),DISP=SHR
//         DD  DSN=SIGEC.LAB.SQL.LIMPEZA(RESETID),DISP=SHR
//

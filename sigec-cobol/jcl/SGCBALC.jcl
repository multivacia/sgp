//SGCBALC  JOB (SIGEC,ALOC),'ALOCACAO DATASETS',
//         CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//         NOTIFY=&SYSUID,REGION=0M,TIME=15
//*
//*----------------------------------------------------------------*
//* SISTEMA .: SIGEC                                              *
//* JCL .....: SGCBALC  - ALOCACAO INICIAL DOS DATASETS FIXOS     *
//* FUNCAO ..: CRIA DATASETS BASE, PDS DE PARM/PROC/LOAD/COPY,    *
//*            CATALOGOS GDG E BOOTSTRAP DE ARQUIVOS DE APOIO.    *
//* USO .....: EXECUCAO UNICA POR AMBIENTE. RERUN EXIGE LIMPEZA   *
//*            PREVIA (VER SGCBLIMP).                             *
//*----------------------------------------------------------------*
//*
//*-------- 1) DATASETS SEQUENCIAIS DE APOIO -----------------------
//STEP010  EXEC PGM=IEFBR14
//SGLPARM  DD  DSN=SIGEC.LAB.PARM.SGLPARM,
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(5,2)),
//             DCB=(RECFM=FB,LRECL=100,BLKSIZE=27900)
//SGLFERIA DD  DSN=SIGEC.LAB.CALEND.SGLFERIA,
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(5,2)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//SGLBLOQ  DD  DSN=SIGEC.LAB.OPS.SGLBLOQ,
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(5,2)),
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=27800)
//SGLESTAT DD  DSN=SIGEC.LAB.OPS.SGLESTAT,
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(10,5)),
//             DCB=(RECFM=FB,LRECL=150,BLKSIZE=27750)
//SGLERROS DD  DSN=SIGEC.LAB.OPS.SGLERROS,
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(10,5)),
//             DCB=(RECFM=FB,LRECL=160,BLKSIZE=27840)
//*
//*-------- 2) GDG BASES ------------------------------------------
//STEP020  EXEC PGM=IDCAMS
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
  DEFINE GDG (NAME(SIGEC.LAB.IN.SGLCTRIN)  LIMIT(20) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(SIGEC.LAB.IN.SGLPAGIN)  LIMIT(20) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(SIGEC.LAB.OUT.SGLCTRVL) LIMIT(20) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(SIGEC.LAB.OUT.SGLCTRRE) LIMIT(20) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(SIGEC.LAB.OUT.SGLPAGVL) LIMIT(20) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(SIGEC.LAB.OUT.SGLPAGRE) LIMIT(20) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(SIGEC.LAB.OUT.SGLENCAR) LIMIT(20) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(SIGEC.LAB.OUT.SGLINADI) LIMIT(20) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(SIGEC.LAB.OUT.SGLPROP)  LIMIT(20) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(SIGEC.LAB.OUT.SGLINTCB) LIMIT(20) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(SIGEC.LAB.OUT.SGLINTCT) LIMIT(20) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(SIGEC.LAB.OUT.SGLINTRG) LIMIT(20) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(SIGEC.LAB.OUT.SGLRELDT) LIMIT(30) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(SIGEC.LAB.OUT.SGLRELST) LIMIT(30) SCRATCH NOEMPTY)
  DEFINE GDG (NAME(SIGEC.LAB.LOG.SGLLOG)   LIMIT(30) SCRATCH NOEMPTY)
/*
//*
//*-------- 3) MODEL DSCB PARA GDG ---------------------------------
//STEP030  EXEC PGM=IEFBR14
//MODEL    DD  DSN=SIGEC.LAB.GDG.MODEL,
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(1,0)),
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=27800)
//

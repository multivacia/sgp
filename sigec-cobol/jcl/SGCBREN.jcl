//SGCBREN  JOB (SIGEC,RENEG),'RENEGOCIACAO',
//         CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//         NOTIFY=&SYSUID,REGION=0M,TIME=60
//*
//*----------------------------------------------------------------*
//* SISTEMA .: SIGEC                                              *
//* JCL .....: SGCBREN  - EXECUCAO ISOLADA DE RENEGOCIACAO         *
//* FUNCAO ..: RODA SGCB0160 (GERACAO DE INTERFACES DE RENEG.).    *
//*            USA O SGLPROP DA JANELA ATUAL COMO INSUMO.          *
//* USO .....: REPROCESSAMENTO A PEDIDO DA AREA DE COBRANCA.       *
//*----------------------------------------------------------------*
//*
//JOBLIB   DD  DSN=SIGEC.LAB.LOADLIB,DISP=SHR
//         DD  DSN=DB2P.DB2.SDSNLOAD,DISP=SHR
//*
//*-------- STEP160 - GERACAO DE INTERFACES DE RENEGOCIACAO -------
//STEP160  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD  DSN=SIGEC.LAB.LOADLIB,DISP=SHR
//         DD  DSN=DB2P.DB2.SDSNLOAD,DISP=SHR
//SYSTSPRT DD  SYSOUT=*
//SYSPRINT DD  SYSOUT=*
//SYSTSIN  DD  *
  DSN SYSTEM(DB2P)
  RUN  PROGRAM(SGCB0160) PLAN(SIGECPLN) -
       LIB('SIGEC.LAB.LOADLIB')
  END
//SGLPROP  DD  DSN=SIGEC.LAB.OUT.SGLPROP(0),DISP=SHR
//SGLINTRG DD  DSN=SIGEC.LAB.OUT.SGLINTRG(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,5)),
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=27800)
//SGLERROS DD  DSN=SIGEC.LAB.OPS.SGLERROS,DISP=MOD
//SYSOUT   DD  SYSOUT=*
//

//SGCBVAL  JOB (SIGEC,VAL),'VALIDACAO SAIDAS',
//         CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//         NOTIFY=&SYSUID,REGION=0M,TIME=30
//*
//*----------------------------------------------------------------*
//* SISTEMA .: SIGEC                                              *
//* JCL .....: SGCBVAL  - VALIDACAO POS-JANELA (CHECKS SIMPLES)    *
//* FUNCAO ..: EXECUTA UMA BATERIA MINIMA DE CONFERENCIAS SOBRE    *
//*            AS SAIDAS DA JANELA: EXISTE ARQUIVO? TEM REGISTRO?  *
//*            SOMA DE TRAILER BATE? RC=0 -> OK, RC=4 -> WARN.     *
//*----------------------------------------------------------------*
//*
//*-------- STEP010 - COPIA SGLRELDT PARA CONFERENCIA -------------
//STEP010  EXEC PGM=IEBGENER
//SYSPRINT DD  SYSOUT=*
//SYSUT1   DD  DSN=SIGEC.LAB.OUT.SGLRELDT(0),DISP=SHR
//SYSUT2   DD  DSN=&&RELDTBK,
//             DISP=(NEW,PASS,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(20,10)),
//             DCB=(RECFM=FB,LRECL=240,BLKSIZE=27600)
//SYSIN    DD  DUMMY
//*
//*-------- STEP020 - SORT + COUNT (VERIFICA VOLUME MINIMO) -------
//STEP020  EXEC PGM=SORT,COND=(0,NE,STEP010)
//SORTIN   DD  DSN=&&RELDTBK,DISP=(OLD,DELETE)
//SORTOUT  DD  SYSOUT=*
//SYSOUT   DD  SYSOUT=*
//SYSIN    DD  *
  SORT   FIELDS=COPY
  OUTFIL FNAMES=SORTOUT,TRAILER1=('QT RECS=',COUNT=(TO=ZD,LENGTH=9))
/*
//*
//*-------- STEP030 - ICETOOL: BATE CONTAGEM COM TRAILER ----------
//STEP030  EXEC PGM=ICETOOL,COND=(0,NE)
//TOOLMSG  DD  SYSOUT=*
//DFSMSG   DD  SYSOUT=*
//SYSPRINT DD  SYSOUT=*
//SORTIN   DD  DSN=SIGEC.LAB.OUT.SGLRELST(0),DISP=SHR
//SORTOUT  DD  SYSOUT=*
//TOOLIN   DD  *
  COUNT FROM(SORTIN) EMPTY
  DISPLAY FROM(SORTIN) LIST(SORTOUT) -
          HEADER('LINHA') ON(1,80,CH)
/*
//*
//*-------- STEP040 - CHECK INTERFACES (CANNOT BE EMPTY) ----------
//STEP040  EXEC PGM=ICETOOL,COND=(0,NE)
//TOOLMSG  DD  SYSOUT=*
//DFSMSG   DD  SYSOUT=*
//INTFCB   DD  DSN=SIGEC.LAB.OUT.SGLINTCB(0),DISP=SHR
//INTFCT   DD  DSN=SIGEC.LAB.OUT.SGLINTCT(0),DISP=SHR
//TOOLIN   DD  *
  COUNT FROM(INTFCB) NOTEMPTY RC4
  COUNT FROM(INTFCT) NOTEMPTY RC4
/*
//

//SGCBREL  JOB (SIGEC,RELAT),'RELATORIOS',
//         CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//         NOTIFY=&SYSUID,REGION=0M,TIME=60
//*
//*----------------------------------------------------------------*
//* SISTEMA .: SIGEC                                              *
//* JCL .....: SGCBREL  - EXECUCAO ISOLADA DOS RELATORIOS DIARIOS  *
//* FUNCAO ..: RODA SGCB0190 (RELATORIO DETALHADO + SINTETICO +    *
//*            INTERFACE DE COBRANCA + CONTABIL).                  *
//* USO .....: REGERAR RELATORIOS QUANDO NECESSARIO (SEM RERUN     *
//*            DOS DEMAIS STEPS DA JANELA).                        *
//*----------------------------------------------------------------*
//*
//JOBLIB   DD  DSN=SIGEC.LAB.LOADLIB,DISP=SHR
//         DD  DSN=DB2P.DB2.SDSNLOAD,DISP=SHR
//*
//*-------- STEP190 - RELATORIOS ----------------------------------
//STEP190  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD  DSN=SIGEC.LAB.LOADLIB,DISP=SHR
//         DD  DSN=DB2P.DB2.SDSNLOAD,DISP=SHR
//SYSTSPRT DD  SYSOUT=*
//SYSPRINT DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//SYSTSIN  DD  *
  DSN SYSTEM(DB2P)
  RUN  PROGRAM(SGCB0190) PLAN(SIGECPLN) -
       LIB('SIGEC.LAB.LOADLIB')
  END
//SGLENCAR DD  DSN=SIGEC.LAB.OUT.SGLENCAR(0),DISP=SHR
//SGLINADI DD  DSN=SIGEC.LAB.OUT.SGLINADI(0),DISP=SHR
//SGLPROP  DD  DSN=SIGEC.LAB.OUT.SGLPROP(0),DISP=SHR
//SGLERRIN DD  DSN=SIGEC.LAB.OPS.SGLERROS,DISP=SHR
//SGLRELDT DD  DSN=SIGEC.LAB.OUT.SGLRELDT(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(20,10)),
//             DCB=(RECFM=FB,LRECL=240,BLKSIZE=27600)
//SGLRELST DD  DSN=SIGEC.LAB.OUT.SGLRELST(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(TRK,(15,5)),
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=27800)
//SGLINTCB DD  DSN=SIGEC.LAB.OUT.SGLINTCB(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,5)),
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=27800)
//SGLINTCT DD  DSN=SIGEC.LAB.OUT.SGLINTCT(+1),
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(10,5)),
//             DCB=(RECFM=FB,LRECL=200,BLKSIZE=27800)
//SGLERROT DD  DSN=SIGEC.LAB.OPS.SGLERROS.OUT,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,5)),
//             DCB=(RECFM=FB,LRECL=160,BLKSIZE=27840)
//

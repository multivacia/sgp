//SGCBORFN JOB (SIGEC,MANUT),'ORFAO MANUTENCAO',
//         CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//         NOTIFY=&SYSUID,REGION=0M,TIME=15
//*
//*----------------------------------------------------------------*
//* SISTEMA .: SIGEC                                              *
//* JCL .....: SGCBORFN - PROGRAMA ORFAO DE MANUTENCAO             *
//* FUNCAO ..: EXECUTA SGCBORFN (E, EM ROTA DE ARQUEOLOGIA,        *
//*            SGCB0999) - AMBOS NAO FAZEM PARTE DO FLUXO COMUM    *
//*            E NAO SAO INVOCADOS PELO DRIVER SGCB0010.           *
//* USO .....: ROTINAS DE INSPECAO/RECUPERACAO DISPARADAS APENAS   *
//*            SOB CHAMADO DA AREA DE APLICACAO.                   *
//* NOTA ....: ESTE JCL EXISTE INTENCIONALMENTE COMO PONTO FORA    *
//*            DA COBERTURA COMUM DO SIGEC. NAO REMOVER SEM        *
//*            ACORDO DA MANUTENCAO CORRETIVA.                     *
//*----------------------------------------------------------------*
//*
//JOBLIB   DD  DSN=SIGEC.LAB.LOADLIB,DISP=SHR
//*
//*-------- STEP010 - PROGRAMA ORFAO DE MANUTENCAO ----------------
//STEP010  EXEC PGM=SGCBORFN
//STEPLIB  DD  DSN=SIGEC.LAB.LOADLIB,DISP=SHR
//SYSPRINT DD  SYSOUT=*
//SYSOUT   DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//*---- ENTRADAS PARA INSPECAO (SOMENTE LEITURA) ------------------
//SGLINADI DD  DSN=SIGEC.LAB.OUT.SGLINADI(0),DISP=SHR
//SGLPROP  DD  DSN=SIGEC.LAB.OUT.SGLPROP(0),DISP=SHR
//SGLLOG   DD  DSN=SIGEC.LAB.LOG.SGLLOG(0),DISP=SHR
//*---- SAIDA DE DIAGNOSTICO ---------------------------------------
//DIAGOUT  DD  SYSOUT=*
//*
//*-------- STEP999 - SIMULADOR LEGADO SGCB0999 -------------------
//*         MANTIDO POR COMPATIBILIDADE HISTORICA. DEVE FALHAR COM
//*         S806 (MODULO NAO ENCONTRADO) NA MAIORIA DOS AMBIENTES,
//*         POIS SGCB0999 NAO ESTA MAIS NO STEPLIB DE PRODUCAO.
//*         O JCL SEGUE VIVO COMO PONTO DE REFERENCIA A UM PROGRAMA
//*         QUE O DRIVER NUNCA CHAMA E QUE O FLUXO ATUAL IGNORA.
//STEP999  EXEC PGM=SGCB0999,COND=EVEN
//STEPLIB  DD  DSN=SIGEC.LAB.LOADLIB,DISP=SHR
//SYSPRINT DD  SYSOUT=*
//SYSOUT   DD  SYSOUT=*
//SYSUDUMP DD  SYSOUT=*
//

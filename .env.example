VITE_DATA_MODE=mock
VITE_API_BASE_URL=
# Porta da API para o proxy do Vite (deve coincidir com PORT em server/.env, ex.: 4000)
VITE_DEV_API_PORT=4000
# Opcional: URL completa do target do proxy (sobrepõe VITE_DEV_API_PORT)
# VITE_DEV_API_TARGET=http://127.0.0.1:4000
VITE_SUPPORT_TICKETS_ENABLED=0

# SGP Print Agent — impressão térmica direta (localhost)
# VITE_PRINT_AGENT_URL=http://127.0.0.1:8765
# VITE_PRINT_AGENT_TOKEN=troque-este-token-local

# Modo Fábrica — proteção leve de kiosk.
# Deve coincidir com PRODUCTION_KIOSK_TOKEN no server/.env.
# Em dev/test pode ser omitido. Em produção, defina o mesmo valor do servidor.
# VITE_PRODUCTION_KIOSK_TOKEN=

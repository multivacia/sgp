NODE_ENV=development
# Deve coincidir com VITE_DEV_API_PORT na raiz do repo (proxy do Vite → API).
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Autenticação (JWT em cookie httpOnly). Mínimo 16 caracteres.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_DAYS=7
AUTH_COOKIE_NAME=sgp_auth

# Modo Fábrica (PIN operacional — cookie e JWT separados do login administrativo).
# PRODUCTION_AUTH_COOKIE_NAME=sgp_production_auth
# Em produção, defina segredo dedicado (mín. 16 caracteres):
# PRODUCTION_JWT_SECRET=
# PRODUCTION_SESSION_IDLE_TIMEOUT_MINUTES=30
# PRODUCTION_SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# PRODUCTION_PIN_MAX_FAILED_ATTEMPTS=5
# PRODUCTION_PIN_LOCKOUT_MINUTES=15
#
# Proteção leve de kiosk: quando definido, GET /production/collaborators exige
# o header X-SGP-Kiosk-Token com este valor. Em produção, SEMPRE defina este token.
# Em dev/test pode ser omitido para manter a rota aberta.
# PRODUCTION_KIOSK_TOKEN=

# Lockout por tentativas falhadas de login (conta existente, senha inválida).
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15

# Opcional: em produção, permite GET /api/v1/health/db com header X-SGP-Infra-Token (mín. 32 caracteres).
# Se omitido, só sessão humana com permissão system.health_db.
# HEALTH_INFRA_TOKEN=

# Opcional: senha da conta demo criada pelo seed (maria@exemplo.com)
# SEED_DEMO_PASSWORD=SenhaSegura123

# Forma preferida para dev local simples
PGHOST=localhost
PGPORT=5432
PGDATABASE=sgp
PGUSER=postgres
PGPASSWORD=CHANGE_ME

# Opcional: URL completa tem prioridade sobre PG*
# DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/sgp

# Opcional
# PG_POOL_MAX=20
# REQUIRE_DB_ON_STARTUP=1

# ARGOS — ingestão de documento (POST /api/v1/conveyors/document-draft).
# Adapter explícito (padrão seguro dev/HML: pipeline local R6 OS Bravo — não inferir de ARGOS_INGEST_URL):
DOCUMENT_DRAFT_ADAPTER=local
# Use remote somente quando o gateway ARGOS já suportar contrato 1.1.0 completo:
# DOCUMENT_DRAFT_ADAPTER=remote
# DOCUMENT_DRAFT_ADAPTER=stub
#
# URL do gateway ARGOS — obrigatória só para DOCUMENT_DRAFT_ADAPTER=remote (outros usos podem continuar a precisar da URL).
# ARGOS_INGEST_URL=https://argos.example/v1/documents
# ARGOS_INGEST_TOKEN=
# Opcional: callerEnvironment no multipart (até 64 chars).
# ARGOS_CALLER_ENVIRONMENT=development
# Modo de política do pipeline no ARGOS: economy | balanced | quality
# ARGOS_POLICY_MODE=balanced
# ARGOS_INGEST_TIMEOUT_MS=120000
# DOCUMENT_DRAFT_MAX_FILE_BYTES=15728640
# ARGOS_REMOTE_REQUIRED=0
# ARGOS_USE_MINIMAL_STUB=0
# Alias legacy (menor prioridade que DOCUMENT_DRAFT_ADAPTER): forçam adapter local
# DOCUMENT_DRAFT_USE_LOCAL_PIPELINE=1
# SGP_LOCAL_DOCUMENT_PIPELINE=1

# R6 — Diagnóstico pipeline document-draft (manter desligado em HML contínuo / produção).
# Ausente ou ≠ '1' → desligado.
# SGP_DOCUMENT_DRAFT_PIPELINE_FLAGS=0
# SGP_DOCUMENT_DRAFT_DEBUG_CANDIDATE_LINES=0
# Liga apenas para troubleshooting controlado (com pipeline flags = 1 onde aplicável):
# SGP_DOCUMENT_DRAFT_PIPELINE_FLAGS=1
# SGP_DOCUMENT_DRAFT_DEBUG_CANDIDATE_LINES=1

# R6 S9.4 — Logs comparativos na criação de esteira (payload vs BD); NODE_ENV!==production também ativa logs reduzidos.
# CONVEYOR_CREATE_DIAGNOSTICS=0

# ARGOS — análise de saúde de esteira (cliente SGP; rotas BFF já expostas em /api/v1/conveyors/:id/health-analysis*).
# Base + path; o token reutiliza ARGOS_INGEST_TOKEN (Bearer) se definido.
# ARGOS_BASE_URL=https://argos.example
# ARGOS_CONVEYOR_HEALTH_ANALYZE_PATH=/api/v1/specialists/conveyor-health/analyze
# ARGOS_HEALTH_TIMEOUT_MS=120000
# ARGOS_HEALTH_ENABLED=1

# SUPPORT tickets (MVP)
SUPPORT_TICKETS_ENABLED=0
SUPPORT_EMAIL_ENABLED=0
SUPPORT_WHATSAPP_ENABLED=0
# E-mail (SMTP) — quando SUPPORT_EMAIL_ENABLED=1
# SUPPORT_EMAIL_FROM=sgp@seudominio.com
# SUPPORT_EMAIL_REPLY_TO=suporte@seudominio.com
# SUPPORT_EMAIL_SUBJECT_PREFIX=[SGP]
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=usuario
# SMTP_PASS=senha
# SMTP_REQUIRE_TLS=1
# Listas CSV de destinos por canal
# SUPPORT_ROUTING_DEFAULT_EMAIL=suporte@empresa.com
# SUPPORT_ROUTING_DEFAULT_WHATSAPP=5511999999999
# SUPPORT_ROUTING_MEDIUM_EMAIL=suporte@empresa.com
# SUPPORT_ROUTING_HIGH_EMAIL=suporte@empresa.com,gestao@empresa.com
# SUPPORT_ROUTING_HIGH_WHATSAPP=5511999999999,5511888888888

# --- Backups (gestão administrativa; app inicia com BACKUP_ENABLED=false) ---
# Não versionar senha: usa PGPASSWORD / pgPoolConfig via env do processo filho.
BACKUP_ENABLED=false
# BACKUP_DIRECTORY=
BACKUP_RETENTION_DAYS=14
BACKUP_SCHEDULE_CRON=0 2 * * *
# Override opcional da conexão de dump (default = PG* / DATABASE_URL)
# BACKUP_DATABASE_NAME=
# BACKUP_DATABASE_HOST=
# BACKUP_DATABASE_PORT=
# BACKUP_DATABASE_USER=
BACKUP_FILE_PREFIX=sgp
# BACKUP_WAL_DIRECTORY=
# BACKUP_MAX_DOWNLOAD_SIZE_BYTES=
BACKUP_COMMAND_TIMEOUT_SECONDS=3600
BACKUP_PG_DUMP_PATH=pg_dump
BACKUP_PG_RESTORE_PATH=pg_restore
# Modelo de configuração dos scripts de backup/restore do SGP+ (bash):
#   scripts/db/backup-db.sh, scripts/db/list-backups.sh, scripts/db/restore-db.sh
#
# Copie para /opt/sgp/backup.env (ou aponte SGP_BACKUP_CONFIG para outro caminho)
# e ajuste. Permissões sugeridas: chmod 600, dono = usuário que executa os scripts.
#
# NÃO coloque senhas aqui. Use ~/.pgpass (chmod 600) do usuário que executa:
#   127.0.0.1:5433:*:sgp_backup:<senha>
#   127.0.0.1:5433:*:postgres:<senha>
#
# Linhas vazias ou comentadas usam o valor padrão indicado.
# Ver docs/runbooks/backup-restore-postgresql.md

# --- PostgreSQL ---
# Diretório dos binários cliente; o major do pg_dump deve ser >= ao do servidor.
PG_BIN_DIR=/usr/lib/postgresql/18/bin
PGHOST=127.0.0.1
PGPORT=5433
# Role somente leitura (pg_read_all_data) usada pelo backup-db.sh.
BACKUP_PGUSER=sgp_backup
# Role administrativa usada pelo restore-db.sh (CREATE/RENAME/DROP DATABASE).
RESTORE_PGUSER=postgres
# Dono das bases e objetos restaurados (normalmente a role da aplicação). Vazio = RESTORE_PGUSER.
RESTORE_DB_OWNER=
# Base copiada por padrão.
BACKUP_DB=sgp_prod
# Bases que o restore-db.sh pode substituir (separadas por espaço).
ALLOWED_TARGET_DBS="sgp_prod"

# --- Arquivos e retenção ---
BACKUP_ROOT=/opt/sgp/backups
# Conjuntos daily em $BACKUP_ROOT/local/ mais antigos que N dias são apagados.
DAILY_RETENTION_DAYS=14
# Conjuntos adhoc/pre-restore em $BACKUP_ROOT/adhoc/; 0 = nunca apagar.
ADHOC_RETENTION_DAYS=90

# --- Aplicação ---
APP_DIR=/opt/sgp/sgp-main
# Opcional: endpoint de versão da API (ex.: http://127.0.0.1:<porta-api>/api/v1/version).
VERSION_URL=
# Opcional: URL verificada após subir a API no restore (ex.: http://127.0.0.1:<porta-api>/api/v1/health).
HEALTH_URL=
# Tempo máximo (s) aguardando HEALTH_URL responder após a troca.
HEALTH_TIMEOUT_SECONDS=60
PM2_PROCESS=sgp-api
# Opcional: usuário dono do PM2 (o restore usa "sudo -u <PM2_USER>").
PM2_USER=
PM2_CMD=pm2
# Opcional: arquivo criado durante a troca (nginx pode exibir página de manutenção).
MAINTENANCE_FLAG=
# Jobs paralelos do pg_restore.
RESTORE_JOBS=2

# --- Alertas por e-mail (falhas) ---
# Vazio = alertas só no log.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SENDMAIL_CMD=/usr/sbin/sendmail
